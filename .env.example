# Copy this file to .env and fill only local values there.
# Never commit real OpenRouter keys or machine-local secrets.

# Required for real provider calls. Keep this blank in the example file.
OPENROUTER_API_KEY=

# Optional. Leave empty or unset to use the backend default:
# nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=

OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_TITLE=gpt-copy-v6
DATABASE_URL=sqlite:gpt-copy-v6.db
BACKEND_BIND_ADDR=127.0.0.1:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
